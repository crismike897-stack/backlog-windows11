@echo off
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Add-Type -AssemblyName System.Windows.Forms; if ([System.Windows.Forms.MessageBox]::Show('?Desinstalar Backlog Screensaver?', 'Desinstalar', 'YesNo', 'Question') -eq 'Yes') { Get-CimInstance Win32_Process -Filter \"Name='powershell.exe' OR Name='wscript.exe'\" | Where-Object { $_.CommandLine -like '*AppData\Local\BacklogScreensaver*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; Remove-Item (Join-Path ([Environment]::GetFolderPath('Startup')) 'BacklogVigilante.vbs') -Force -ErrorAction SilentlyContinue; Remove-Item (Join-Path ([Environment]::GetFolderPath('Desktop')) 'Backlog Screensaver.lnk') -Force -ErrorAction SilentlyContinue; Remove-Item (Join-Path $env:LOCALAPPDATA 'BacklogScreensaver') -Recurse -Force -ErrorAction SilentlyContinue; [System.Windows.Forms.MessageBox]::Show('Desinstalado correctamente.', 'Listo', 'OK', 'Information'); }"
